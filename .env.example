# Copy to .env and fill in. Never commit .env.

# OANDA: create an account at oanda.com, then generate a token at
# Account -> My Services -> Manage API Access
OANDA_TOKEN=your-oanda-api-token
OANDA_ACCOUNT_ID=101-001-1234567-001

# "practice" = demo money (recommended to start), "live" = real money
OANDA_ENV=practice

# Telegram: message @BotFather, /newbot, paste the token here
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# Leave empty on first run: message your bot and it will reply with your chat id,
# then put it here and restart.
TELEGRAM_CHAT_ID=
