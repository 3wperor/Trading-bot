# systemd unit for the forex bot.
# Install (adjust paths/user if your clone lives elsewhere):
#   sudo cp deploy/forexbot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now forexbot
# Logs:  journalctl -u forexbot -f

[Unit]
Description=Forex trading bot (OANDA + Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Trading-bot
ExecStart=/home/ubuntu/Trading-bot/.venv/bin/python -m forexbot.main
Restart=on-failure
RestartSec=10
# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
